<template id="rom-card-template">
	<div class="rom-card" role="listitem">
		<div
			class="rom-card-header"
			role="button"
			tabindex="0"
			aria-expanded="false"
			aria-label="Toggle ROM details"
		>
			<svg
				class="rom-card-expand-icon"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
			>
				<path d="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z"></path>
			</svg>
			<span class="rom-card-title"></span>
		</div>
		<div class="rom-card-body">
			<p>
				File Name: <input
					type="text"
					class="rom-card-name"
					data-field="name"
				/>
			</p>
			<p>File Size: <span data-field="size"></span></p>
			<p>ROM Size: <span data-field="romsize"></span></p>
			<p>RAM Size: <span data-field="ramsize"></span></p>
			<p>Region: <span data-field="region"></span></p>
			<p>Video: <span data-field="video"></span></p>
			<p>Type: <span data-field="romtype"></span></p>
			<p>MemMap: <span data-field="memmap"></span></p>
			<p>Checksum: <span data-field="checksum"></span></p>
			<p>SHA-256: <span data-field="hash"></span></p>
			<p>Header: <span data-field="header"></span></p>
		</div>
		<div class="rom-card-actions">
			<button class="btn-remove">remove</button>
		</div>
	</div>
</template>

<style>
	.rom-card {
		margin: 1rem;
		background: var(--sfc-surface);
		border-radius: 2px;
		box-shadow:
			0 1px 3px rgba(38, 37, 43, 0.12),
			0 1px 2px var(--sfc-shadow);
		overflow: hidden;
	}

	.rom-card-header {
		display: flex;
		align-items: center;
		padding: 16px;
		cursor: pointer;
		user-select: none;
	}

	.rom-card-header:hover {
		background: var(--sfc-hover);
	}

	.rom-card-expand-icon {
		width: 24px;
		height: 24px;
		margin-right: 16px;
		transition: transform 0.2s;
		fill: var(--sfc-text-muted);
	}

	.rom-card.expanded .rom-card-expand-icon {
		transform: rotate(180deg);
	}

	.rom-card-title {
		font-size: 16px;
		font-weight: 400;
		color: var(--sfc-text);
	}

	.rom-card-body {
		display: none;
		padding: 16px;
		border-top: 1px solid var(--sfc-divider);
	}

	.rom-card.expanded .rom-card-body {
		display: block;
	}

	.rom-card-body p {
		margin: 4px 0;
		font-size: 14px;
		color: var(--sfc-text);
	}

	.rom-card-actions {
		display: none;
		padding: 8px;
		text-align: right;
		border-top: 1px solid var(--sfc-divider);
	}

	.rom-card.expanded .rom-card-actions {
		display: block;
	}

	.rom-card-name {
		border: none;
		border-bottom: 1px solid rgba(38, 37, 43, 0.2);
		font-size: 14px;
		font-family: "Roboto", sans-serif;
		color: var(--sfc-text);
		padding: 2px 4px;
		width: 60%;
		outline: none;
	}

	.rom-card-name:focus {
		border-bottom-color: var(--sfc-blue);
	}

	.btn-remove {
		padding: 8px 16px;
		border: none;
		background: transparent;
		color: var(--sfc-red);
		font-size: 14px;
		font-weight: 500;
		text-transform: uppercase;
		cursor: pointer;
		border-radius: 2px;
		font-family: "Roboto", sans-serif;
		letter-spacing: 0.5px;
	}

	.btn-remove:hover {
		background: rgba(184, 50, 60, 0.1);
	}

	@media (max-width: 480px) {
		.rom-card {
			margin: 0.5rem;
		}

		.rom-card-header {
			padding: 12px;
		}

		.rom-card-body {
			padding: 12px;
			word-break: break-all;
		}

		.rom-card-name {
			width: 100%;
		}
	}
</style>
