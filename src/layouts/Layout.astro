---
interface Props {
	title: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogImageAlt?: string;
	canonical?: string;
}

const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const {
	title,
	description = "Batch convert SNES ROM formats between .smc and .sfc entirely in the browser. No uploads, no backend.",
	ogTitle = "smc2sfc2 — SNES ROM Converter",
	ogDescription = "Batch convert SNES ROM formats between .smc and .sfc entirely in the browser.",
	ogImage = `${site}/og.png`,
	ogImageAlt = "smc2sfc2 — SNES ROM Converter. Batch convert .smc to .sfc in the browser.",
	canonical = site
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="canonical" href={canonical} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#2d4f9e" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css?family=Roboto:300,400,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script is:inline src="/sw-register.js" defer></script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Super Famicom palette: warm cartridge-plastic body, the X-button blue
	   as chrome, and the A/B/Y buttons as the accent stripe. */
	:root {
		--sfc-bg: #d7d2c6;
		--sfc-surface: #fffdf7;

		--sfc-red: #c2373f;
		--sfc-yellow: #e8bb3a;
		--sfc-green: #3f9556;
		--sfc-blue: #2d4f9e;

		--sfc-chrome: var(--sfc-blue);
		--sfc-chrome-90: rgba(45, 79, 158, 0.92);
		--sfc-overlay: rgba(63, 149, 86, 0.88);
		--sfc-ink: #2b2822;

		--sfc-text: rgba(43, 40, 34, 0.87);
		--sfc-text-muted: rgba(43, 40, 34, 0.54);
		--sfc-text-faint: rgba(43, 40, 34, 0.45);
		--sfc-on-dark: #fbfaf5;
		--sfc-on-dark-muted: #cfd9ef;

		--sfc-divider: rgba(43, 40, 34, 0.1);
		--sfc-hover: rgba(43, 40, 34, 0.06);
		--sfc-hover-dark: rgba(255, 255, 255, 0.14);
		--sfc-shadow: rgba(43, 40, 34, 0.24);

		--sfc-buttons: linear-gradient(
			90deg,
			var(--sfc-red) 0 33.33%,
			var(--sfc-yellow) 33.33% 66.66%,
			var(--sfc-green) 66.66% 100%
		);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		background-color: var(--sfc-bg);
		height: 100%;
		font-family: "Roboto", sans-serif;
	}

	body {
		background: url("../assets/gamepad.svg") no-repeat center center fixed;
		background-size: contain;
		height: 100%;
		margin: 0;
	}
</style>
