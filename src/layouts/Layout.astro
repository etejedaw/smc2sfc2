---
interface Props {
	title: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogImageAlt?: string;
	canonical?: string;
}

const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const {
	title,
	description = "Batch convert SNES ROM formats between .smc and .sfc entirely in the browser. No uploads, no backend.",
	ogTitle = "smc2sfc2 — SNES ROM Converter",
	ogDescription = "Batch convert SNES ROM formats between .smc and .sfc entirely in the browser.",
	ogImage = `${site}/og.png`,
	ogImageAlt = "smc2sfc2 — SNES ROM Converter. Batch convert .smc to .sfc in the browser.",
	canonical = site
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="canonical" href={canonical} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#45444c" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css?family=Roboto:300,400,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script is:inline src="/sw-register.js" defer></script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Super Famicom palette: light grey plastic body, dark grey slot,
	   and the four face-button colours used as accents. */
	:root {
		--sfc-bg: #cfcbc2;
		--sfc-surface: #faf9f6;
		--sfc-charcoal: #45444c;
		--sfc-charcoal-90: rgba(69, 68, 76, 0.9);
		--sfc-charcoal-85: rgba(69, 68, 76, 0.85);

		--sfc-red: #b8323c;
		--sfc-yellow: #deb13a;
		--sfc-green: #3e8e52;
		--sfc-blue: #35599e;

		--sfc-text: rgba(38, 37, 43, 0.87);
		--sfc-text-muted: rgba(38, 37, 43, 0.54);
		--sfc-text-faint: rgba(38, 37, 43, 0.45);
		--sfc-on-dark: #f2f1ee;
		--sfc-on-dark-muted: #c9c6bf;

		--sfc-divider: rgba(38, 37, 43, 0.1);
		--sfc-hover: rgba(38, 37, 43, 0.06);
		--sfc-hover-dark: rgba(255, 255, 255, 0.12);
		--sfc-shadow: rgba(38, 37, 43, 0.24);

		--sfc-buttons: linear-gradient(
			90deg,
			var(--sfc-red) 0 25%,
			var(--sfc-yellow) 25% 50%,
			var(--sfc-green) 50% 75%,
			var(--sfc-blue) 75% 100%
		);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		background-color: var(--sfc-bg);
		height: 100%;
		font-family: "Roboto", sans-serif;
	}

	body {
		background: url("../assets/gamepad.svg") no-repeat center center fixed;
		background-size: contain;
		height: 100%;
		margin: 0;
	}
</style>
